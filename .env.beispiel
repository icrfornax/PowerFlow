# Vorlage. NICHT ausfuellen und einchecken -- diese Datei ist die Vorlage,
# die echten Werte gehoeren in `.env`, und `.env` ist gitignored.
#
# Woher die Werte kommen: docs/beleg-redispatch.md
NT_CLIENT_ID=
NT_CLIENT_SECRET=

# ENTSO-E Transparency Platform, RESTful API.
# Der Schluessel wird im Portal unter "My Account Settings" erzeugt, nachdem
# der Zugang per E-Mail freigeschaltet wurde. Ein Wert, keine zwei -- anders
# als bei netztransparenz.de, wo es ein OAuth-Paar aus ID und Secret ist.
#
# Wofuer: die Lizenzkette des Redispatch von einer Argumentation zu einer
# Zusage machen. Siehe docs/beleg-redispatch.md und die offenen Punkte.
ENTSOE_TOKEN=
